# =============================================================================
# ASL Gesture Detection - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' for local configuration overrides.
# DO NOT commit your actual '.env' file or any private credentials to Git.
# All settings below have safe, built-in defaults if omitted.
# =============================================================================

# --- Camera Settings ---
ASL_CAMERA_DEVICE_ID=0
ASL_CAMERA_WIDTH=1280
ASL_CAMERA_HEIGHT=720
ASL_CAMERA_FPS=30

# --- Tracker & Detection Sensitivity ---
ASL_TRACKER_CONFIDENCE=0.65
ASL_TRACKER_RUNNING_MODE=video
ASL_ENABLE_CLAHE=true

# --- Classifier & Accuracy Thresholds ---
ASL_CLASSIFIER_MODE=hybrid
ASL_MIN_CONFIDENCE=0.92

# --- Speller, Word Formation & TTS Audio ---
ASL_ENABLE_TTS=true
ASL_VOICE_RATE=150
ASL_ENABLE_AUTOCOMPLETE=true

# --- Motion & Gesture Timings ---
ASL_HOLD_FRAMES=18
ASL_CONFIRM_HOLD_FRAMES=14
ASL_COOLDOWN_FRAMES=12
ASL_NEUTRAL_FRAMES=8
